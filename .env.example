APP_NAME="THILOR DESIGN"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# En développement local : l'URL exacte que vous tapez dans le navigateur
# (ex. http://localhost:8000 avec `php artisan serve`, ou votre vhost local).
# En production : votre nom de domaine réel, en https://, une fois le SSL actif
# (voir docs/DEPLOIEMENT_OVH.md). Cette valeur sert à générer les URLs
# d'images/assets — une valeur incorrecte casse leur affichage.
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données MySQL fournie par l'Hébergement Web OVH.
# Voir docs/DEPLOIEMENT_OVH.md § 2 pour créer la base et récupérer ces valeurs
# dans l'espace client OVH (Hébergements > Bases de données).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions et cache stockés en base (pas de Redis/Memcached nécessaire sur
# un mutualisé OVH).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false en local (le site tourne en http://) — mettre impérativement à true
# en production dès que le HTTPS est actif (voir docs/DEPLOIEMENT_OVH.md § 4) :
# un cookie "secure" sur un site servi en http:// ne serait jamais envoyé par
# le navigateur, ce qui déconnecterait les utilisateurs en boucle.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# En local : "log" écrit les emails dans storage/logs/laravel.log au lieu de
# les envoyer (aucun serveur SMTP à configurer pour développer). En production,
# passez à "smtp" avec les identifiants OVH/votre prestataire mail — voir
# docs/DEPLOIEMENT_OVH.md § 11.
MAIL_MAILER=log
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@thilor-design.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
