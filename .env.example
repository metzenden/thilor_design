APP_NAME="THILOR DESIGN"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.thilor-design.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base de données MySQL fournie par l'Hébergement Web OVH.
# Voir docs/DEPLOIEMENT_OVH.md § 2 pour créer la base et récupérer ces valeurs
# dans l'espace client OVH (Hébergements > Bases de données).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions et cache stockés en base (pas de Redis/Memcached nécessaire sur
# un mutualisé OVH). SESSION_SECURE_COOKIE=true est obligatoire dès que le
# site tourne en HTTPS (voir docs/DEPLOIEMENT_OVH.md § 4).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Configuration mail SMTP (voir docs/DEPLOIEMENT_OVH.md § 11 pour les valeurs
# fournies par OVH ou votre prestataire mail).
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@thilor-design.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
